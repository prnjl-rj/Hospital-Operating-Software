# =============================================================================
# HOSPITAL OPERATING SOFTWARE (HOS) — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and populate with local or secret-managed values.
# NEVER commit actual secrets or .env files to version control.
# =============================================================================

NODE_ENV=development

# --- Service Ports ---
API_GATEWAY_PORT=4000
IDENTITY_SERVICE_PORT=4001
HOSPITAL_CORE_SERVICE_PORT=4002
CLINICAL_EMR_SERVICE_PORT=4003
DIAGNOSTICS_PHARMACY_SERVICE_PORT=4004
OPERATIONS_BILLING_SERVICE_PORT=4005
GRPC_IDENTITY_URL=localhost:50051
GRPC_HOSPITAL_CORE_URL=localhost:50052
FRONTEND_PORT=5175

# --- PostgreSQL (Per-Service Schema Ownership) ---
POSTGRES_SUPERUSER_URL="postgresql://hos_admin:CHANGE_ME@localhost:5435/hos_db?schema=public"
IDENTITY_DATABASE_URL="postgresql://hos_identity_user:CHANGE_ME@localhost:5435/hos_db?schema=identity"
HOSPITAL_CORE_DATABASE_URL="postgresql://hos_core_user:CHANGE_ME@localhost:5435/hos_db?schema=hospital_core"
CLINICAL_DATABASE_URL="postgresql://hos_clinical_user:CHANGE_ME@localhost:5435/hos_db?schema=clinical"
DIAGNOSTICS_DATABASE_URL="postgresql://hos_diag_user:CHANGE_ME@localhost:5435/hos_db?schema=diagnostics_pharmacy"
OPERATIONS_DATABASE_URL="postgresql://hos_ops_user:CHANGE_ME@localhost:5435/hos_db?schema=operations_billing"

# --- JWT & Authentication ---
JWT_ACCESS_SECRET="CHANGE_ME_MIN_32_CHARS_ACCESS_SECRET"
JWT_REFRESH_SECRET="CHANGE_ME_MIN_32_CHARS_REFRESH_SECRET"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
INTERNAL_SERVICE_TOKEN="CHANGE_ME_INTERNAL_S2S_TOKEN"

# --- Apache Kafka (KRaft Mode) ---
KAFKA_BROKERS="localhost:9094"
KAFKA_CLIENT_ID="hos-platform"
KAFKA_CONSUMER_GROUP_PREFIX="hos-cg"

# --- Redis & BullMQ ---
REDIS_HOST="localhost"
REDIS_PORT=6380
REDIS_PASSWORD="CHANGE_ME_REDIS_PASSWORD"

# --- AWS & S3 Document Storage ---
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="CHANGE_ME_OR_USE_IAM_ROLE"
AWS_SECRET_ACCESS_KEY="CHANGE_ME_OR_USE_IAM_ROLE"
S3_BUCKET_DOCUMENTS="hos-medical-documents-dev"
S3_ENDPOINT_OVERRIDE=""

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
OTEL_SERVICE_NAME="hos-platform"
PROMETHEUS_PORT=9095
GRAFANA_PORT=3035

# --- Jira Integration ---
JIRA_BASE_URL="https://your-org.atlassian.net"
JIRA_USER_EMAIL="your-email@example.com"
JIRA_API_TOKEN="CHANGE_ME_JIRA_API_TOKEN"
JIRA_PROJECT_KEY="HOS"
