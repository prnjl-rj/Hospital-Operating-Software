{
  "name": "hos-enterprise-platform",
  "version": "1.0.0",
  "private": true,
  "description": "500+ Bed Multispecialty Hospital Operating Software — Microservices, Kafka, Redis, PostgreSQL, Prisma, React, Observability & AWS",
  "workspaces": [
    "packages/*",
    "services/*",
    "frontend"
  ],
  "scripts": {
    "db:generate": "node scripts/prisma-all.mjs generate",
    "db:push": "node scripts/prisma-all.mjs db-push",
    "db:migrate": "node scripts/prisma-all.mjs migrate",
    "db:triggers": "tsx scripts/apply-triggers.ts",
    "kafka:topics": "tsx scripts/kafka-init-topics.ts",
    "db:seed": "tsx database/seeds/seed-all.ts",
    "db:verify": "tsx database/seeds/verify-db.ts",
    "dev:gateway": "tsx services/api-gateway/src/main.ts",
    "dev:frontend": "npm --workspace=@hos/frontend run dev",
    "build:packages": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/microservices": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-socket.io": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/websockets": "^10.4.15",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@grpc/grpc-js": "^1.12.4",
    "@grpc/proto-loader": "^0.7.13",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-node": "^0.54.2",
    "@prisma/client": "^5.22.0",
    "bullmq": "^5.30.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "kafkajs": "^2.2.4",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "uuid": "^11.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/uuid": "^10.0.0",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
